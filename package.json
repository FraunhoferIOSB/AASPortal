{
	"name": "aas-portal-project",
	"version": "3.9",
	"description": "Web-based visualization and control of asset administration shells.",
	"type": "module",
	"scripts": {
		"create-app-info": "node --no-warnings --loader ts-node/esm create-app-info.ts",
		"set-version": "node --no-warnings --loader ts-node/esm set-version.ts",
		"tsoa": "npm run tsoa -w=aas-node",
		"build:docker": "docker build -f Dockerfile -t aasportal . && docker run -d --name AASPortal -p 80:80 --restart=always aasportal",
		"build:podman": "podman build -f Dockerfile -t aasportal . && podman run -d --name AASPortal -p 80:80 --restart=always aasportal",
		"podman:aas-server": "podman build -f Dockerfile.aas-server -t aasserver . && podman run -d --name AASServer -p 50010:50010 --restart=always aasserver",
		"start:podman-aio": "podman run -p 80:80 docker.io/fraunhoferiosb/aasportal_aio",
		"header": "node --no-warnings --loader ts-node/esm copyright-header.ts",
		"coverage": "node --no-warnings --loader ts-node/esm merge-coverage.ts",
		"lint": "npm run lint --workspaces",
		"format": "npm run format --workspaces",
		"test": "npm run test --workspaces",
		"test:unit": "npm run test --workspaces",
		"tsc": "npm run tsc --workspaces",
		"build": "npm run build --workspaces",
		"build:debug": "npm run build:debug --workspaces",
		"lib:build": "npm run build -w=aas-core -w=aas-lib",
		"lib:build:debug": "npm run build:debug -w=aas-core -w=aas-lib",
		"aas-portal:build": "npm run build -w=aas-core -w=aas-lib -w=aas-portal",
		"aas-portal:build:debug": "npm run build:debug -w=aas-core -w=aas-lib -w=aas-portal",
		"aas-node:build": "npm run build -w=aas-core -w=aas-node",
		"aas-node:build:debug": "npm run build:debug -w=aas-core -w=aas-node",
		"aas-server:build": "npm run build -w=aas-core -w=aas-lib -w=aas-server -w=aas-browser",
		"aas-server:build:debug": "npm run build:debug -w=aas-core -w=aas-lib -w=aas-server -w=aas-browser",
		"serve": "npm run build && node --env-file projects/aas-node/.env projects/aas-node/dist/aas-node.js",
		"docker:test": "docker build -f Dockerfile.test -t test --progress=plain . &> build.log",
		"podman:test": "podman build -f Dockerfile.test -t test --progress=plain . &> build.log",
		"docs": "rimraf ./docs && typedoc"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/eclipse-aasportal/AASPortal.git"
	},
	"author": "Fraunhofer IOSB-INA",
	"homepage": "https://www.iosb-ina.fraunhofer.de/",
	"license": "Apache-2.0",
	"workspaces": [
		"projects/aas-core",
		"projects/aas-package",
		"projects/aas-node",
		"projects/aas-lib",
		"projects/aas-portal",
		"projects/aas-server",
		"projects/aas-browser"
	],
	"dependencies": {
		"@aas-core-works/aas-core3.0-typescript": "^1.0.5",
		"@angular/common": "^22.0.6",
		"@angular/compiler": "^22.0.6",
		"@angular/core": "^22.0.6",
		"@angular/forms": "^22.0.6",
		"@angular/localize": "^22.0.6",
		"@angular/platform-browser": "^22.0.6",
		"@angular/router": "^22.0.6",
		"@ng-bootstrap/ng-bootstrap": "^21.0.0",
		"@ngx-translate/core": "^18.0.0",
		"@ngx-translate/http-loader": "^18.0.0",
		"@popperjs/core": "^2.11.8",
		"@xmldom/xmldom": "^0.8.10",
		"bcryptjs": "^3.0.3",
		"bootstrap": "^5.3.8",
		"bootstrap-icons": "^1.13.1",
		"chart.js": "^4.5.1",
		"compression": "^1.8.1",
		"cookie-parser": "^1.4.7",
		"cors": "^2.8.6",
		"d3-hierarchy": "^3.1.2",
		"express": "^5.2.1",
		"express-session": "^1.19.0",
		"jimp": "^1.6.1",
		"jsonwebtoken": "^9.0.3",
		"jszip": "^3.10.1",
		"jwks-rsa": "^4.1.0",
		"lodash-es": "^4.18.1",
		"marked": "^18.0.5",
		"mongoose": "^9.7.4",
		"multer": "^2.2.0",
		"mysql2": "^3.22.6",
		"nanoid": "^5.1.16",
		"node-opcua": "^2.175.0",
		"node-opcua-client-crawler": "^2.127.1",
		"pino": "^10.3.1",
		"qrcode": "^1.5.4",
		"reflect-metadata": "^0.2.2",
		"rxjs": "~7.8.2",
		"swagger-ui-express": "^5.0.1",
		"tslib": "^2.8.1",
		"tsoa": "^6.6.0",
		"tsyringe": "^4.10.0",
		"webdav": "^5.10.0",
		"ws": "^8.21.0",
		"xpath": "^0.0.34",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@angular/build": "^22.0.5",
		"@angular/cli": "^22.0.5",
		"@angular/compiler-cli": "^22.0.6",
		"@eslint/js": "^9.39.2",
		"@types/bootstrap": "^5.2.11",
		"@types/compression": "^1.8.1",
		"@types/cookie-parser": "^1.4.10",
		"@types/cors": "^2.8.19",
		"@types/d3-hierarchy": "^3.1.7",
		"@types/express": "^5.0.6",
		"@types/express-session": "^1.19.0",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/lodash-es": "^4.17.12",
		"@types/multer": "^2.2.0",
		"@types/node": "^24.10.4",
		"@types/passport": "^1.0.17",
		"@types/qrcode": "^1.5.6",
		"@types/supertest": "^7.2.0",
		"@types/swagger-ui-express": "^4.1.8",
		"@types/ws": "^8.18.1",
		"@vitest/coverage-v8": "^4.1.10",
		"angular-eslint": "22.2.0",
		"esbuild": "^0.28.1",
		"eslint": "^9.39.2",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.6",
		"globals": "^16.5.0",
		"jsdom": "^29.1.1",
		"ng-packagr": "^22.0.1",
		"nyc": "^17.1.0",
		"prettier": "^3.9.4",
		"prettier-eslint": "^16.4.2",
		"rimraf": "^6.1.3",
		"supertest": "^7.2.2",
		"ts-node": "^10.9.2",
		"typedoc": "^0.28.20",
		"typescript": "^6.0.3",
		"typescript-eslint": "8.63.0",
		"vitest": "^4.1.10"
	}
}
