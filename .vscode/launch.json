{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch aas-portal",
            "type": "chrome",
            "request": "launch",
            "preLaunchTask": "start",
            "url": "http://localhost:4200/",
            "webRoot": "${workspaceFolder}"
        },
        {
            "name": "Launch aas-node",
            "type": "node",
            "args": [
                "--experimental-sqlite",
            ],
            "request": "launch",
            "preLaunchTask": "build-aas-node",
            "program": "${workspaceFolder}/projects/aas-node/build/aas-node.js",
            "cwd": "${workspaceFolder}",
            "outFiles": [
                "${workspaceFolder}/projects/aas-node/build/**/*.js"
            ],
            "skipFiles": [
                "<node_internals>/**"
            ],
            "outputCapture": "std",
            "env": {
                "ASSETS": "projects/aas-node/src/assets",
                "CONTENT_ROOT": "projects/aas-node/build",
                "NODE_ENV": "development",
                "WEB_ROOT": "projects/aas-portal/dist/browser"
            }
        },
        {
            "name": "Launch aas-node (SQLite)",
            "type": "node",
            "args": [
                "--experimental-sqlite"
            ],
            "request": "launch",
            "preLaunchTask": "build-aas-node",
            "program": "${workspaceFolder}/projects/aas-node/build/aas-node.js",
            "cwd": "${workspaceFolder}",
            "outFiles": [
                "${workspaceFolder}/projects/aas-node/build/**/*.js"
            ],
            "skipFiles": [
                "<node_internals>/**"
            ],
            "outputCapture": "std",
            "env": {
                "AAS_NODE_PORT": "1337",
                "ASSETS": "projects/aas-node/src/assets",
                "CONTENT_ROOT": "projects/aas-node/build",
                "COOKIE_STORE": "mongodb://aas-node:root-password@localhost:27017/aasportal-users",
                "ENDPOINTS": "[\"http://localhost:50010/api/v3/?name=AAS%20Server\"]",
                "HOST_URL": "http://localhost:4200",
                "IDENTITY_PROVIDER": "mongodb://aas-node:root-password@localhost:27017/aasportal-users",
                "NODE_ENV": "development",
                "SESSION_STORE": "mongodb://aas-node:root-password@localhost:27017/aasportal-users",
                "USER_RIGHTS_STORE": "mongodb://aas-node:root-password@localhost:27017/aasportal-users",
                "USER_STORE": "mongodb://aas-node:root-password@localhost:27017/aasportal-users",
                "WEB_ROOT": "projects/aas-portal/dist/browser"
            }
        },
        {
            "name": "Launch aas-node (keycloak, SQLite)",
            "type": "node",
            "args": [
                "--experimental-sqlite",
                "--use-system-ca"
            ],
            "request": "launch",
            "preLaunchTask": "build-aas-node",
            "program": "${workspaceFolder}/projects/aas-node/build/aas-node.js",
            "cwd": "${workspaceFolder}",
            "outFiles": [
                "${workspaceFolder}/projects/aas-node/build/**/*.js"
            ],
            "skipFiles": [
                "<node_internals>/**"
            ],
            "outputCapture": "std",
            "env": {
                "AAS_NODE_PORT": "1337",
                "ASSETS": "projects/aas-node/src/assets",
                "CLIENT_SECRET": "7YiU4JXS4yaYHJrytrXNw7y71l3z12QN",
                "CONTENT_ROOT": "projects/aas-node/build",
                "COOKIE_STORE": "mongodb://aas-node:root-password@localhost:27017/aasportal-users",
                "ENDPOINTS": "[\"http://localhost:50010/api/v3/?name=AAS%20Server\"]",
                "HOST_URL": "http://localhost:4200",
                "IDENTITY_PROVIDER": "https://localhost:8443/realms/aas-portal",
                "NODE_ENV": "development",
                "NODE_TLS_REJECT_UNAUTHORIZED": "0",
                "REDIRECT_URI": "http://localhost:4200/auth/callback",
                "SESSION_STORE": "mongodb://aas-node:root-password@localhost:27017/aasportal-users",
                "USER_RIGHTS_STORE": "mongodb://aas-node:root-password@localhost:27017/aasportal-users",
                "WEB_ROOT": "projects/aas-portal/dist/browser",
            }
        },
        {
            "name": "Launch aas-node (MariaDB)",
            "type": "node",
            "args": [
                "--experimental-sqlite"
            ],
            "request": "launch",
            "preLaunchTask": "build-aas-node",
            "program": "${workspaceFolder}/projects/aas-node/build/aas-node.js",
            "cwd": "${workspaceFolder}",
            "outFiles": [
                "${workspaceFolder}/projects/aas-node/build/**/*.js"
            ],
            "skipFiles": [
                "<node_internals>/**"
            ],
            "outputCapture": "std",
            "env": {
                "AAS_INDEX": "mysql://aas-node:user-password@localhost:3306",
                "AAS_NODE_PORT": "1337",
                "ASSETS": "projects/aas-node/src/assets",
                "CONTENT_ROOT": "projects/aas-node/build",
                "COOKIE_STORE": "mongodb://aas-node:root-password@localhost:27017/aasportal-users",
                "ENDPOINTS": "[\"http://localhost:50010/api/v3/?name=AAS%20Server\"]",
                "HOST_URL": "http://localhost:4200",
                "NODE_ENV": "development",
                "SESSION_STORE": "mongodb://aas-node:root-password@localhost:27017/aasportal-users",
                "USER_RIGHTS_STORE": "mongodb://aas-node:root-password@localhost:27017/aasportal-users",
                "USER_STORE": "mongodb://aas-node:root-password@localhost:27017/aasportal-users",
                "WEB_ROOT": "projects/aas-portal/dist/browser",
            }
        },
        {
            "name": "Launch aas-node (keycloak, MariaDB)",
            "type": "node",
            "args": [
                "--use-system-ca"
            ],
            "request": "launch",
            "preLaunchTask": "build-aas-node",
            "program": "${workspaceFolder}/projects/aas-node/build/aas-node.js",
            "cwd": "${workspaceFolder}",
            "outFiles": [
                "${workspaceFolder}/projects/aas-node/build/**/*.js"
            ],
            "skipFiles": [
                "<node_internals>/**"
            ],
            "outputCapture": "std",
            "env": {
                "AAS_INDEX": "mysql://aas-node:user-password@localhost:3306",
                "AAS_NODE_PORT": "1337",
                "ASSETS": "projects/aas-node/src/assets",
                "CLIENT_SECRET": "7YiU4JXS4yaYHJrytrXNw7y71l3z12QN",
                "CONTENT_ROOT": "projects/aas-node/build",
                "COOKIE_STORE": "mongodb://aas-node:root-password@localhost:27017/aasportal-users",
                "ENDPOINTS": "[\"http://localhost:50010/api/v3/?name=AAS%20Server\"]",
                "HOST_URL": "http://localhost:4200",
                "IDENTITY_PROVIDER": "https://localhost:8443/realms/aas-portal",
                "NODE_ENV": "development",
                "NODE_TLS_REJECT_UNAUTHORIZED": "0",
                "REDIRECT_URI": "http://localhost:4200/auth/callback",
                "SESSION_STORE": "mongodb://aas-node:root-password@localhost:27017/aasportal-users",
                "USER_RIGHTS_STORE": "mongodb://aas-node:root-password@localhost:27017/aasportal-users",
                "WEB_ROOT": "projects/aas-portal/dist/browser"
            }
        },
        {
            "name": "Attach aas-node (Docker 172.16.160.172)",
            "type": "node",
            "request": "attach",
            "address": "172.16.160.172",
            "port": 9229,
            "localRoot": "${workspaceFolder}/projects/aas-node",
            "remoteRoot": "/usr/src/app",
            "restart": true,
            "skipFiles": [
                "<node_internals>/**"
            ]
        },
        {
            "name": "Launch aas-server",
            "type": "node",
            "args": [],
            "request": "launch",
            "preLaunchTask": "build-aas-server",
            "program": "${workspaceFolder}/projects/aas-server/build/aas-server.js",
            "cwd": "${workspaceFolder}",
            "outFiles": [
                "${workspaceFolder}/projects/aas-server/build/**/*.js"
            ],
            "skipFiles": [
                "<node_internals>/**"
            ],
            "outputCapture": "std",
            "env": {
                "NODE_ENV": "development",
                "AAS_SERVER_PORT": "50010",
                "CONTENT_ROOT": "projects/aas-server/build",
                "WEB_ROOT": "projects/aas-browser/dist/browser",
                "ASSETS": "projects/aas-server/src/assets",
            }
        },
        {
            "name": "Launch aas-server (Auth)",
            "type": "node",
            "args": [],
            "request": "launch",
            "preLaunchTask": "build-aas-server",
            "program": "${workspaceFolder}/projects/aas-server/build/aas-server.js",
            "cwd": "${workspaceFolder}",
            "outFiles": [
                "${workspaceFolder}/projects/aas-server/build/**/*.js"
            ],
            "skipFiles": [
                "<node_internals>/**"
            ],
            "outputCapture": "std",
            "env": {
                "NODE_ENV": "development",
                "AAS_SERVER_PORT": "50010",
                "CONTENT_ROOT": "projects/aas-server/build",
                "WEB_ROOT": "projects/aas-browser/dist/browser",
                "ASSETS": "projects/aas-server/src/assets",
                "API_KEY_HANDLER": "mongodb://aas-node:root-password@localhost:27017/aasportal-users"
            }
        },
        {
            "name": "Launch aas-browser",
            "type": "chrome",
            "request": "launch",
            "preLaunchTask": "launch-aas-browser",
            "url": "http://localhost:4200/"
        },
        {
            "name": "Debug current aas-lib test",
            "type": "node",
            "request": "launch",
            "cwd": "${workspaceFolder}/projects/aas-lib",
            "runtimeExecutable": "ng",
            "args": [
                "test",
                "aas-lib",
                "--debug",
                "--include",
                "${file}"
            ],
        },
        {
            "name": "Debug current aas-portal test",
            "type": "node",
            "request": "launch",
            "cwd": "${workspaceFolder}/projects/aas-portal",
            "runtimeExecutable": "ng",
            "args": [
                "test",
                "aas-portal",
                "--debug",
                "--include",
                "${file}"
            ],
        },
        {
            "name": "Debug current aas-browser test",
            "type": "node",
            "request": "launch",
            "cwd": "${workspaceFolder}/projects/aas-browser",
            "runtimeExecutable": "ng",
            "args": [
                "test",
                "aas-browser",
                "--debug",
                "--include",
                "${file}"
            ],
        }
    ]
}