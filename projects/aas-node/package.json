{
    "name": "aas-node",
    "version": "3.9",
    "author": "Fraunhofer IOSB-INA",
    "license": "Apache 2.0",
    "description": "Web-based visualization and control of asset administration shells.",
    "module": "./dist/aas-node.js",
    "homepage": "https://www.iosb-ina.fraunhofer.de/",
    "type": "module",
    "scripts": {
        "tsoa": "tsoa spec-and-routes -c tsoa.config.json",
        "serve": "rimraf build && npm run tsoa && tsc -p tsconfig.app.json",
        "test": "vitest --run",
        "test:unit": "vitest --run --coverage=false",
        "watch": "vitest --watch --coverage=false",
        "build": "rimraf dist && npm run tsoa && node esbuild.prod.js",
        "build:debug": "rimraf dist && npm run tsoa && node esbuild.dev.js",
        "tsc": "rimraf build && tsc -p tsconfig.json",
        "lint": "eslint src/app/**/*.ts",
        "format": "eslint src/app/**/*.ts --fix",
        "docs": "typedoc --out docs"
    },
    "dependencies": {
        "@xmldom/xmldom": "^0.8.10",
        "bcryptjs": "^3.0.3",
        "compression": "^1.8.1",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.6",
        "express": "^5.2.1",
        "express-session": "^1.19.0",
        "jimp": "^1.6.1",
        "jsonwebtoken": "^9.0.3",
        "jszip": "^3.10.1",
        "jwks-rsa": "^4.1.0",
        "lodash-es": "^4.18.1",
        "mongoose": "^9.7.4",
        "multer": "^2.2.0",
        "mysql2": "^3.22.6",
        "nanoid": "^5.1.16",
        "node-opcua": "^2.175.0",
        "node-opcua-client-crawler": "^2.127.1",
        "pino": "^10.3.1",
        "reflect-metadata": "^0.2.2",
        "swagger-ui-express": "^5.0.1",
        "tslib": "^2.8.1",
        "tsoa": "^6.6.0",
        "tsyringe": "^4.10.0",
        "webdav": "^5.10.0",
        "ws": "^8.21.0",
        "xpath": "^0.0.34",
        "zod": "^4.4.3"
    }
}